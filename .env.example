# Browser shell
VITE_CONVEX_URL=

# Worker / control plane
CONVEX_URL=

# Script defaults
# APP_ID is used by seed and worker helper scripts as the default target app.
APP_ID=softbox
# APP_TEMPLATE_ID is used by seed as the initial template for a newly created app.
APP_TEMPLATE_ID=threejs
WORKER_POLL_INTERVAL_MS=1500

# Agent
AGENT_COMMAND=codex
AGENT_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_MS=600000
JOB_STALE_TIMEOUT_MS=1800000

# Queue
# BullMQ runs inside the worker process and uses Redis for queue state.
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_QUEUE_NAME=softbox-jobs
BULLMQ_QUEUE_CONCURRENCY=1
BULLMQ_QUEUE_ATTEMPTS=2
BULLMQ_QUEUE_BACKOFF_MS=800

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
