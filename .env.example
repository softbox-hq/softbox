# Convex

# should be in format https://<your convex deployment>.convex.cloud
VITE_CONVEX_URL= 

# Use the same Convex deployment URL here for the worker / control plane
CONVEX_URL= 

# Agent

AGENT_COMMAND=openclaw
AGENT_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_MS=600000
WORKER_POLL_INTERVAL_MS=1500

# OpenClaw 
OPENCLAW_GATEWAY_BASE_URL=http://127.0.0.1:18789
# Gateway token that you accessing openclaw gateway.
OPENCLAW_GATEWAY_TOKEN=
# Leave blank to let Softbox generate a checkout-scoped per-app prefix automatically.
OPENCLAW_AGENT_ID_PREFIX=
OPENCLAW_SESSION_KEY_PREFIX=softbox # keep as is

# Queue
# BullMQ runs inside the worker process and uses Redis for queue state.
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_QUEUE_NAME=softbox-jobs
BULLMQ_QUEUE_CONCURRENCY=1
BULLMQ_QUEUE_ATTEMPTS=2
BULLMQ_QUEUE_BACKOFF_MS=800
JOB_STALE_TIMEOUT_MS=1800000

# Cloudflare R2
# for example: https://<account>.r2.cloudflarestorage.com/<bucket>
S3_API=
PUBLIC_DEVELOPMENT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
