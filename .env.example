# Browser shell
VITE_CONVEX_URL=

# Worker / control plane
CONVEX_URL=

# Script defaults
# APP_ID is the only source id used by seed and worker helper scripts.
# It must match a wrapped app directory under /apps, for example /apps/vite-default.
APP_ID=vite-default
WORKER_POLL_INTERVAL_MS=1500

# Agent
AGENT_COMMAND=codex
AGENT_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_MS=600000
JOB_STALE_TIMEOUT_MS=1800000

# OpenClaw gateway adapter
# Enable by setting AGENT_COMMAND=openclaw.
# The worker uses `openclaw gateway call agent` over the WS gateway.
# The configured OpenClaw agent must have a workspace that can edit this repo/app.
# HTTP(S) values are normalized to WS(S) automatically.
# Set OPENCLAW_AGENT_ID for one shared repo-level agent, or OPENCLAW_AGENT_ID_PREFIX
# for one agent per app, e.g. `softbox-vite-default`.
OPENCLAW_GATEWAY_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=
OPENCLAW_AGENT_ID_PREFIX=
OPENCLAW_SESSION_KEY_PREFIX=softbox

# Queue
# BullMQ runs inside the worker process and uses Redis for queue state.
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_QUEUE_NAME=softbox-jobs
BULLMQ_QUEUE_CONCURRENCY=1
BULLMQ_QUEUE_ATTEMPTS=2
BULLMQ_QUEUE_BACKOFF_MS=800

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
