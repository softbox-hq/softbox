{
  "name": "softbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "bootstrap": "tsx scripts/setup.ts",
    "setup": "tsx scripts/setup.ts",
    "new-app": "tsx scripts/new-app.ts",
    "start": "tsx scripts/dev.tsx",
    "start:verbose": "tsx scripts/dev.tsx --verbose",
    "start:sync-agents": "tsx scripts/dev.tsx",
    "start:no-sync-agents": "tsx scripts/dev.tsx --no-sync-agents",
    "dev:shell": "vite --config shell/vite.config.ts",
    "dev:worker": "tsx watch --exclude '.tmp/**' --exclude '/tmp/live-runtime-state-*' worker/src/index.ts",
    "dev:convex": "convex dev",
    "build:shell": "vite build --config shell/vite.config.ts",
    "generate:elements-numbr": "tsx scripts/generate-elements-numbr.ts",
    "generate:datahub": "tsx scripts/generate-datahub.ts",
    "generate:horizons": "tsx scripts/generate-horizons.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx worker/src/seed.ts",
    "wrap-app": "tsx scripts/wrap-app.ts",
    "worker:agent-stage": "tsx worker/scripts/inspect-agent-stage.ts",
    "worker:backfill-box-profiles": "tsx worker/scripts/backfill-box-profiles.ts",
    "worker:migrate-app-ids": "tsx worker/scripts/migrate-app-ids.ts",
    "worker:openclaw-sync-agents": "tsx worker/scripts/sync-openclaw-agents.ts",
    "worker:queue-clear": "tsx worker/scripts/queue-clear.ts",
    "worker:state": "tsx worker/scripts/inspect-worker-state.ts",
    "worker:recover-running": "tsx worker/scripts/recover-running-job.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/react": "^0.3.2",
    "@inquirer/prompts": "^8.3.2",
    "@openai/codex-sdk": "^0.115.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "bullmq": "^5.71.0",
    "convex": "^1.33.1",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
